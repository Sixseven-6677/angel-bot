# ╔══════════════════════════════════════════════════╗
# ║          Angel Bot — متغيرات البيئة             ║
# ╚══════════════════════════════════════════════════╝
#
# انسخ هذا الملف إلى .env وعدّل القيم
# أو أضفها مباشرة في إعدادات Railway / Variables

# ─── إعدادات الاتصال بفيسبوك (مطلوب أحدهما) ───────

# الخيار 1 (الأفضل): محتوى appstate.json كـ JSON array
# احصل عليه من إضافة c3c-ufc-utility في المتصفح
APPSTATE_JSON=

# الخيار 2: Cookies الخام من المتصفح
FB_COOKIES=

# ─── إعدادات اختيارية ──────────────────────────────

# مفتاح تشفير الجلسات (غيّره لقيمة عشوائية)
SESSION_SECRET=angel_secret_change_me

# المنطقة الزمنية
TZ=Africa/Cairo

# بيئة التشغيل
NODE_ENV=production
